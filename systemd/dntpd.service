[Unit]
Description=Dragon NTP Server (DNTPD) - RFC 5905/8915 Compliant
Documentation=https://github.com/drakon/dntpd
After=network.target nss-lookup.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/sbin/dntpd
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dntpd

# NTP требует привязки к порту 123
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

# Ограничения безопасности
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/dntpd /var/log

# Рабочая директория
WorkingDirectory=/var/lib/dntpd

# Ограничения ресурсов
LimitNOFILE=1024
LimitNPROC=64

[Install]
WantedBy=multi-user.target
